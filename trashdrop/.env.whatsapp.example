# ============================================
# WhatsApp Booking Layer - Environment Variables
# ============================================
# Copy this to .env.development.local for local dev, or set in the
# Netlify Dashboard (Site settings → Environment variables) for production.
# NEVER commit real values to this file.

# --- Meta WhatsApp Cloud API ---
# Get these from Meta Business Suite → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_token_here

# App Secret from developers.facebook.com → App Settings → Basic.
# Used to verify the X-Hub-Signature-256 header on incoming webhooks.
META_APP_SECRET=your_meta_app_secret_here

# Webhook verification token (you define this — must match Meta webhook config)
WHATSAPP_VERIFY_TOKEN=your_chosen_verify_token_here

# --- Booking Flow (whatsapp-flows/bin-pickup.flow.json) ---
# Flow id from WhatsApp Manager -> Flows. Leave unset to collect the schedule
# and bin details message-by-message instead of in the native form.
WHATSAPP_FLOW_ID=your_flow_id_here
# 'draft' lets the Flow's creator test before publishing; 'published' for live.
WHATSAPP_FLOW_MODE=published

# --- Supabase (service role for server-side functions) ---
# Settings → API → service_role key (NOT the anon key, which is public).
# These are different from the REACT_APP_ prefixed anon key used client-side.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- Outbound Notifications ---
# Shared secret for authenticating Supabase database webhook calls to
# whatsapp-notify. Generate with: openssl rand -hex 32
WHATSAPP_NOTIFY_SECRET=your_random_secret_here

# ============================================
# Setup Steps:
# ============================================
# 1. Create a Meta Business account at business.facebook.com
# 2. Add WhatsApp product to your app at developers.facebook.com
# 3. Get a test phone number from Meta (free tier: 1,000 conversations/month)
# 4. Configure webhook URL: https://your-site.netlify.app/.netlify/functions/whatsapp-webhook
# 5. Subscribe to "messages" webhook field
# 6. Set WHATSAPP_VERIFY_TOKEN to match what you enter in Meta's webhook config
# 7. Generate a permanent System User access token (not the temporary one)
# 8. Create the guest auth user in Supabase Dashboard → Authentication → Add user:
#    email whatsapp-guest@trashdrop.app (auto-confirm ON). Required for bookings
#    from WhatsApp users who have no app account.
# 9. In Supabase Dashboard → Database → Webhooks, add:
#    - Table: digital_bins
#    - Events: UPDATE
#    - URL: https://your-site.netlify.app/.netlify/functions/whatsapp-notify
#    - Headers: x-webhook-secret: <WHATSAPP_NOTIFY_SECRET value>
